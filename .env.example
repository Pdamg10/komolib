# Copia este archivo a .env y coloca tus valores reales (nunca subas .env a Git)

# ============================================================
# CLIENTE (App PC Electron / APK Android / Vite)
# ============================================================
# URL pública del API de sincronización, Google OAuth y salas compartidas.
# En builds de producción (PC / Android) usa automáticamente el API oficial en Cloudflare Workers:
#   https://komolib-api.komolib.workers.dev
# Define esta variable solo si despliegas tu propio Worker o servidor Express:
VITE_SYNC_SERVER_URL=

# Opcional: URL pública para enlaces y códigos QR de invitación.
VITE_PUBLIC_APP_URL=

# ============================================================
# CLOUD API PRINCIPAL — Cloudflare Workers + D1 (cloudflare/)
# ============================================================
# En Cloudflare Workers NO se usa .env en producción; configura los secretos con Wrangler:
#   cd cloudflare
#   npx wrangler secret put GOOGLE_CLIENT_ID
#   npx wrangler secret put GOOGLE_CLIENT_SECRET
#   npx wrangler secret put GEMINI_API_KEY
# Y `GEMINI_MODEL` se configura en `cloudflare/wrangler.toml`.

# ============================================================
# SERVIDOR OPCIONAL LAN / SELF-HOSTED (server/index.js)
# ============================================================
# Estas variables van en el hosting del API Node.js (LAN / VPS / Render / Railway) o en server/.env.
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OAuth de Google Drive (almacenamiento personal del usuario en Google Drive / Komolib / Libros)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recomendado si expones el servidor Express a Internet: protege tu biblioteca personal PC <-> APK.
# Las salas compartidas (KOMO-XXXX) y estanterías (SHELF-XXXX) siguen funcionando para invitados
# sin compartir tu token.
KOMOLIB_TOKEN=

# Opcional: URL pública fija del API (se muestra en /api/network-info).
PUBLIC_URL=

# Opcional: puerto del API Express (Render/Railway lo inyectan automáticamente como PORT).
PORT=4123

# Opcional: carpeta persistente para libros, portadas y datos del servidor Express.
# En hostings con disco efímero monta un volumen persistente y apunta aquí.
KOMOLIB_STORAGE_DIR=
