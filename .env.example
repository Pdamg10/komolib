# Copia este archivo a .env y coloca tus valores reales (nunca subas .env a Git)

# ============================================================
# FRONTEND (Vite / Netlify)
# ============================================================
# URL pública del servidor de sincronización y salas compartidas.
# En Netlify: Site configuration -> Environment variables -> Add a variable
#   VITE_SYNC_SERVER_URL = https://tu-api.onrender.com
# Sin esta variable la web funciona como lector local, pero los códigos QR,
# las salas KOMO-XXXX y la sincronización Web <-> APK no funcionarán.
VITE_SYNC_SERVER_URL=

# Opcional: URL pública de la app web (la de Netlify). Se usa para construir
# enlaces/QR de invitación cuando se generan desde el APK Android, donde el
# origen local no es accesible para los invitados.
#   VITE_PUBLIC_APP_URL = https://tu-app.netlify.app
VITE_PUBLIC_APP_URL=

# ============================================================
# SERVIDOR DE SINCRONIZACIÓN (server/index.js)
# ============================================================
# Estas variables van en el hosting del API (Render, Railway, Fly.io, VPS...),
# NO en Netlify (Netlify solo publica el frontend estático).
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Recomendado si expones KomoLib a Internet: protege tu biblioteca personal Web <-> APK.
# Las salas compartidas con código KOMO-XXXX siguen funcionando para invitados sin
# compartir tu token.
KOMOLIB_TOKEN=

# Opcional: URL pública fija del API (se muestra en la información de red).
PUBLIC_URL=

# Opcional: puerto del API. Render/Railway lo inyectan automáticamente como PORT.
PORT=4123

# Opcional: carpeta persistente para libros, portadas y datos del servidor.
# En hostings con disco efímero (Render free, Railway sin volumen) los archivos
# subidos se pierden al reiniciar. Monta un volumen persistente y apunta aquí.
KOMOLIB_STORAGE_DIR=
