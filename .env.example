# Copia este archivo a .env y coloca tus valores reales (nunca subas .env a Git)
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Recomendado si expones KomoLib a Internet: protege tu biblioteca personal Web <-> APK
# (Las salas compartidas con código KOMO-XXXX siguen funcionando para invitados sin compartir tu token)
KOMOLIB_TOKEN=

# Opcional: URL pública fija (Cloudflare Tunnel nombrado, ngrok, Tailscale Funnel o VPS)
PUBLIC_URL=

# Opcional: pon true (o usa `npm run dev:tunnel`) para abrir automáticamente un túnel HTTPS Cloudflare
AUTO_TUNNEL=false
# Opcional: ruta manual al binario cloudflared si no está en tu PATH
CLOUDFLARED_PATH=
