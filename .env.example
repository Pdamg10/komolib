# Copia este archivo a .env y coloca tus valores reales (nunca subas .env a Git)

# ============================================================
# CLIENTE (App PC / APK Android / Vite)
# ============================================================
# URL pública del servidor de sincronización y salas compartidas.
#   VITE_SYNC_SERVER_URL = https://komolib-api.onrender.com
# Sin esta variable en desarrollo se usa el servidor local o el valor oficial en producción.
VITE_SYNC_SERVER_URL=

# Opcional: URL pública para enlaces y QR de invitación.
VITE_PUBLIC_APP_URL=

# ============================================================
# SERVIDOR DE SINCRONIZACIÓN (server/index.js)
# ============================================================
# Estas variables van en el hosting del API (Render, Railway, Fly.io, VPS...) o en server/.env.
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OAuth de Google Drive (almacenamiento personal del usuario en Google Drive / Komolib / Libros)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recomendado si expones KomoLib a Internet: protege tu biblioteca personal PC <-> APK.
# Las salas compartidas con código KOMO-XXXX siguen funcionando para invitados sin
# compartir tu token.
KOMOLIB_TOKEN=

# Opcional: URL pública fija del API (se muestra en la información de red).
PUBLIC_URL=

# Opcional: puerto del API. Render/Railway lo inyectan automáticamente como PORT.
PORT=4123

# Opcional: carpeta persistente para libros, portadas y datos del servidor.
# En hostings con disco efímero (Render free, Railway sin volumen) los archivos
# subidos se pierden al reiniciar. Monta un volumen persistente y apunta aquí.
KOMOLIB_STORAGE_DIR=
