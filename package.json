{
  "name": "komolib",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:run": "electron .",
    "desktop:build:linux": "npm run build && electron-builder --linux AppImage",
    "desktop:build:win": "npm run build && electron-builder --win nsis",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "aief:doctor": "aief-init doctor",
    "aief:validate": "aief-init validate refs"
  },
  "build": {
    "appId": "com.komolib.reader",
    "productName": "Komolib",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.svg"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Education",
      "artifactName": "Komolib-${version}.AppImage"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "epubjs": "^0.3.93",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.12",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@tongsh6/aief-init": "^1.9.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
